{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "dependencyDashboard": true,
  "enabledManagers": ["github-actions", "gomod", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update annotated CI dependency pins",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?\\s*\\n\\s*[A-Z][A-Z0-9_]*:\\s*[^@\\s]+@(?<currentValue>[^\\s]+)",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?\\s*\\n\\s*[A-Z][A-Z0-9_]*_VERSION:\\s*(?<currentValue>v?[0-9][^\\s]*)"
      ]
    }
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "labels": ["dependencies", "github-actions"]
    },
    {
      "matchDepNames": [
        "dagger/dagger-for-github",
        "manjaro_stable/dagger",
        "riftonix/daggerverse"
      ],
      "groupName": "dagger toolchain",
      "labels": ["dependencies", "dagger"]
    },
    {
      "matchDepNames": ["github.com/google/docsy", "google/docsy"],
      "groupName": "hugo docsy site",
      "labels": ["dependencies", "hugo"]
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "go modules",
      "labels": ["dependencies", "go"]
    }
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rangeStrategy": "bump"
}
